# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Required for voice Q&A and exam-answer coaching (server-side only, never exposed to the browser).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for Q&A / grading. Defaults to a fast, low-cost model suitable for short curriculum-aligned answers.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
