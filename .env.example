# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Postgres connection string. Local dev: point at a local Postgres instance.
# On Railway: auto-injected once the Postgres plugin is linked to this service
# (${{Postgres.DATABASE_URL}}), no manual value needed there.
DATABASE_URL=postgresql://studyezy:studyezy@localhost:5432/studyezy

# Where uploaded textbook page photos are stored on disk. Local dev defaults
# to ./uploads (outside public/, since Next's static assets are baked in at
# build time). On Railway, point this at a mounted Volume, e.g. /data/uploads,
# so photos survive redeploys.
UPLOADS_DIR=./uploads

# Required for voice Q&A and exam-answer coaching (server-side only, never exposed to the browser).
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for Q&A / grading. Defaults to a fast, low-cost model suitable for short curriculum-aligned answers.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional: open-weight-model fallback (voice Q&A, Micro-Check reactions) for
# whenever ANTHROPIC_API_KEY isn't configured or a call fails. Free tier, no
# card required. Get one at https://console.groq.com -> API Keys -> Create Key.
GROQ_API_KEY=
