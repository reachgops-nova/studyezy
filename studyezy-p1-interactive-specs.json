      "interactions": {
        "step_1": {
          "instruction_en": "Tap the word 'WINKED' to see what Jo does with her eyes!",
          "instruction_hi": "\u091c\u094b \u0915\u0940 \u0906\u0901\u0916\u094b\u0902 \u0915\u0940 \u0939\u0930\u0915\u0924 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 'WINKED' \u0936\u092c\u094d\u0926 \u0915\u094b \u091b\u0941\u090f\u0902!",
          "trigger_target": "winked-btn",
          "action": "Toggle right-eye-open (hide) and right-eye-wink (show) with a spring bounce. Play eye-blink sound effect.",
          "ezy_feedback_en": "A wink means she shares a sneaky secret! Look, she is closing one eye!",
          "ezy_feedback_hi": "\u0906\u0901\u0916 \u092e\u093e\u0930\u0928\u093e (wink) \u092f\u093e\u0928\u0940 \u0935\u0939 \u0915\u094b\u0908 \u0917\u0941\u092a\u094d\u0924 \u0936\u0930\u093e\u0930\u0924 \u0938\u093e\u091d\u093e \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948! \u0926\u0947\u0916\u094b, \u0909\u0938\u0928\u0947 \u090f\u0915 \u0906\u0901\u0916 \u092c\u0902\u0926 \u0915\u0940!"
        },
        "step_2": {
          "instruction_en": "Now tap 'GRINNED' to see her facial expression!",
          "instruction_hi": "\u0905\u092c \u091c\u094b \u0915\u0947 \u091a\u0947\u0939\u0930\u0947 \u0915\u0947 \u092d\u093e\u0935 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f 'GRINNED' \u0936\u092c\u094d\u0926 \u0915\u094b \u091b\u0941\u090f\u0902!",
          "trigger_target": "grinned-btn",
          "action": "Toggle mouth-neutral (hide) and mouth-grin (show) with a scale-up animation. Show star burst particles near her eyes.",
          "ezy_feedback_en": "That cheeky grin means she's up to mischief! She's not just smiling, she is proud of her trick!",
          "ezy_feedback_hi": "\u0935\u0939 \u0936\u0930\u093e\u0930\u0924\u0940 \u092e\u0941\u0938\u094d\u0915\u093e\u0928 (grin) \u0926\u0930\u094d\u0936\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u0935\u0939 \u0915\u094b\u0908 \u091a\u093e\u0932 \u091a\u0932 \u0930\u0939\u0940 \u0939\u0948! \u0935\u0939 \u0917\u0930\u094d\u0935 \u0938\u0947 \u092e\u0941\u0938\u094d\u0915\u0941\u0930\u093e \u0930\u0939\u0940 \u0939\u0948!"
        }
