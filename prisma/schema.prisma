generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- accounts / auth ---

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("parent") // "parent" | "admin" - the very first account ever registered becomes admin automatically
  createdAt    DateTime @default(now())
  // 30-day free trial from signup - set at INSERT time (now() + 30 days),
  // so it's always relative to when this specific account registered, not a
  // global cutoff. Admin accounts bypass trial gating in code (lib/pricing.ts)
  // rather than getting special-cased here, so the column stays simple.
  trialEndsAt  DateTime @default(dbgenerated("(now() + interval '30 days')"))
  // Parent/account-level contact + location, optional, self/admin-only
  // visibility. Never interpolated into any AI prompt.
  phone        String?
  state        String?
  district     String?

  sessions          Session[]
  studentProfiles   StudentProfile[]
  uploadedPages     UploadedPage[]
  createdSubjects   Subject[]      @relation("SubjectCreatedBy")
  createdUnits      Unit[]         @relation("UnitCreatedBy")
  uploadedResources UnitResource[] @relation("ResourceUploadedBy")
  approvedResources UnitResource[] @relation("ResourceApprovedBy")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model StudentProfile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  avatarEmoji String   @default("🦊")
  createdAt   DateTime @default(now())

  // Optional override for which Stage's content this kid should see by
  // default on /select - null means "browse normally" (matches their
  // account's usual picks). Lets a parent put a kid on a different grade's
  // book than their nominal age/grade would suggest (e.g. a Grade 4 kid
  // working from the Grade 5 book) without changing anything about the
  // shared, centralized curriculum data itself - every kid on the same
  // Stage still reads the exact same Concept rows.
  assignedStageId String?
  assignedStage   Stage?   @relation(fields: [assignedStageId], references: [id], onDelete: SetNull)

  // Optional, self-reported "intelligence" fields (2026-08-20 decision) - not
  // used to gate or select content (assignedStageId still does that), just
  // declared context for admin visibility and future personalization once
  // there's real usage data to design against. preferredCurriculumLabel
  // matches PricingPlan.curriculumLabel's 5 values on purpose, but is a
  // plain string, not an FK - only Cambridge has real seeded Curriculum rows
  // today, the other 4 boards are pricing/intent-only so far.
  schoolName               String?
  preferredCurriculumLabel String?
  enrolledSubjectSlugs     String[] @default([])

  testAttempts      TestAttempt[]
  conceptMasteries  ConceptMastery[]
  interactionEvents InteractionEvent[]
  reasoningLogs     ReasoningLog[]
  examSubmissions   ExamSubmission[]
  worksheetAttempts WorksheetAttempt[]
  unitProgress      UnitProgress[]
}

// --- curriculum hierarchy ---

model Curriculum {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  stages Stage[]
}

model Stage {
  id           String     @id @default(cuid())
  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  number       Int
  label        String
  available    Boolean    @default(false)
  subjects     Subject[]

  assignedProfiles StudentProfile[]

  @@unique([curriculumId, number])
}

model Subject {
  id              String   @id @default(cuid())
  stageId         String
  stage           Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  slug            String
  name            String
  available       Boolean  @default(false)
  createdByUserId String?
  createdBy       User?    @relation("SubjectCreatedBy", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())
  units           Unit[]

  @@unique([stageId, slug])
}

model Unit {
  id                   String   @id @default(cuid())
  subjectId            String
  subject              Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitKey              String   @unique // e.g. "cambridge-5-english-1" - preserves current URL scheme
  number               Int
  title                String
  board                String   @default("Cambridge") // exam board label, e.g. "Cambridge" - independent of the curriculum pathway name
  available            Boolean  @default(false)
  unitStatus           String   @default("in_progress") // "in_progress" | "complete"
  contentMode          String   @default("curriculum") // "curriculum" (Learn -> workbook -> tiered test) | "olympiad" (skip Learn, practice sets -> 2 exam sets)
  sourcePublisher      String?
  sourceTitle          String?
  sourceAuthors        String[]
  sourceSeriesEditors  String[]
  sourceNote           String?
  masteryChecklist     Json? // UnitMasteryChecklist passthrough
  createdByUserId      String?
  createdBy            User?    @relation("UnitCreatedBy", fields: [createdByUserId], references: [id])
  createdAt            DateTime @default(now())

  concepts        Concept[]
  uploadedPages   UploadedPage[]
  testAttempts    TestAttempt[]
  examSubmissions ExamSubmission[]
  resources       UnitResource[]
  questionPapers  QuestionPaper[]
  contentPacks    ContentPack[]
  worksheetAttempts WorksheetAttempt[]
  progressMarkers UnitProgress[]

  @@unique([subjectId, number])
}

// A student/parent-set "our class has covered up to here" marker (real
// feedback 2026-09-05: "school might reserve certain concepts to be taught
// later, so kids can mark till which concept within a unit was taught for
// our reference"). Deliberately separate from ConceptMastery - it's a
// manual claim about the SCHOOL's own pacing, not evidence from an attempt
// in this app, and a school's own concept order doesn't have to match this
// unit's 1.1/1.2/1.3... numbering. Used to exempt concepts at or before the
// mark from the out-of-sequence readiness check in UnitView.tsx.
model UnitProgress {
  id                   String   @id @default(cuid())
  studentProfileId     String
  studentProfile       StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  unitId               String
  unit                 Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  taughtUpToConceptKey String?
  updatedAt            DateTime @updatedAt

  @@unique([studentProfileId, unitId])
}

// A "markable" content pack (content/schema/pack.schema.json) - the
// declarative-check alternative to Concept's prose fields, built to answer
// a real gap: prose can be read aloud but never marked right/wrong. Admin-
// only research surface for now (see content/HANDOFF.md and PLATFORM_PLAN.md's
// 2026-08-24 entry) - not wired into the live student-facing teaching flow
// yet. `data` is the full pack JSON (validated against pack.schema.json
// before being saved); the other fields are denormalized summary counts so
// the admin list view doesn't need to parse `data` for every row.
model ContentPack {
  id              String   @id @default(cuid())
  packId          String   @unique
  // Nullable: a "terminal_test" pack spans every unit a student has tested
  // on, not one - it uses subjectId below instead. worksheet/progression_test
  // packs always have a real unitId.
  unitId          String?
  unit            Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subjectId       String?
  data            Json
  sheetsCount     Int      @default(0)
  questionsCount  Int      @default(0)
  needsHumanCount Int      @default(0)
  errorsCount     Int      @default(0)
  warningsCount   Int      @default(0)
  status          String   @default("draft") // "draft" | "clean" | "needs_review" | "failed"
  sourceImageKeys String[]
  model           String
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  createdAt       DateTime @default(now())

  // "worksheet" (default, admin-converted real pages) | "progression_test"
  // (deterministically converted from an existing QuestionPaper, see
  // lib/questionPaperToPack.ts) | "terminal_test" (assembled across every
  // unit a student has tested on, see lib/terminalTest.ts). difficulty only
  // applies to progression_test packs - mirrors QuestionPaper's own tiers,
  // and together with purpose+unitId makes a converted test pack cacheable
  // instead of re-converted on every request.
  purpose    String  @default("worksheet")
  difficulty String?

  worksheetAttempts WorksheetAttempt[]

  @@unique([unitId, purpose, difficulty])
  @@index([unitId])
}

// A single practice attempt at a ContentPack worksheet - low-stakes,
// retry-as-many-times practice, deliberately kept separate from
// TestAttempt/ConceptMastery (see PLATFORM_PLAN.md's 2026-08-24 entry): a
// wrong answer here never affects mastery data, it just measures "is this
// kid ready to unlock the formal test" (lib/worksheetGate.ts) and how much
// tougher an older unit's recommended test tier should be
// (lib/adaptiveDifficulty.ts).
model WorksheetAttempt {
  id               String   @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  contentPackId    String
  contentPack      ContentPack    @relation(fields: [contentPackId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  correctCount     Int
  totalCount       Int
  scorePct         Int
  answers          Json     // snapshot of {questionId: {value, correct}}, for later review
  attemptedAt      DateTime @default(now())

  @@index([studentProfileId, unitId])
}

// Up to 3 self-test papers per unit, one per difficulty (2026-08-20 decision:
// "easy/moderate/tough" so a kid can choose their own challenge level rather
// than one fixed paper). Replaces the old single Unit.progressionTestDraft
// Json? column - that could only ever hold one paper, and regenerating it
// destroyed whatever was there before. questions/coversConcepts/note mirror
// the old ProgressionTestDraft shape exactly (lib/types.ts) - only the
// storage moved, not the content shape.
model QuestionPaper {
  id             String   @id @default(cuid())
  unitId         String
  unit           Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  difficulty     String // "easy" | "moderate" | "tough"
  coversConcepts String[]
  note           String?
  questions      Json // TestQuestion[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([unitId, difficulty])
}

model Concept {
  id                        String   @id @default(cuid())
  unitId                    String
  unit                      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  conceptKey                String // matches concept_id, e.g. "1.1"
  name                      String
  status                    String   @default("outline") // "outline" | "drafted"
  difficulty                String?
  bookPages                 Int[]
  storyReferenceTitle       String?
  storyReferenceSynopsis    String?  @db.Text
  definition                String?  @db.Text
  keyPoints                 String[]
  examples                  String[]
  tipsToRemember            String[]
  reasoningInterviewPrompts String[]
  voiceQaSamples            Json?
  illustrationKey           String?
  sourceImagePath           String?
  // A precise transcript of what's actually printed on sourceImagePath -
  // generated once via Claude vision when the image is linked (see
  // lib/conceptImageTranscription.ts), never re-derived per question. Without
  // this, askConceptQuestion/askConceptQuestionGroq only know the
  // hand-authored definition/key_points/examples text, not the specific
  // content of the real reference page they're displaying, so a student
  // asking about something visible in the picture ("solve no 6 above") got
  // "I'm not able to see the picture" - a real gap reported 2026-08-22.
  sourceImageTranscript     String?  @db.Text
  illustrationCaption       String?
  // Extra visual analogies (e.g. a pizza AND a bar model for fractions),
  // beyond the one primary illustration shown on the lesson card - lets the
  // AI tutor insert a matching picture into the chat itself when a student
  // asks to see one mid-conversation. Array of {illustration_key, caption}.
  alternateIllustrations    Json?
  videoStatus               String   @default("not_planned")
  source                    String   @default("hand_authored") // "hand_authored" | "extracted"
  orderIndex                Int      @default(0)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  conceptMasteries  ConceptMastery[]
  interactionEvents InteractionEvent[]
  reasoningLogs     ReasoningLog[]

  @@unique([unitId, conceptKey])
}

// --- uploads ---

model UploadedPage {
  id               String   @id @default(cuid())
  unitId           String
  unit             Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  storageKey       String // relative path under UPLOADS_DIR, e.g. "cambridge-5-english-1/171...-ab12.jpg"
  originalFilename String
  mimeType         String
  byteSize         Int
  purpose          String   @default("textbook_source") // "textbook_source" | "exam_page"
  // The real printed textbook page this image shows, when known (2026-09-06
  // - real bug found while seeding Units 2-9's galleries: UnitView.tsx's
  // booklet jumped to a concept's cited page via `pageImages[page - 1]`,
  // silently assuming this unit's array starts at book page 1. That only
  // ever worked for Unit 1 by coincidence (it starts near page 1) - Unit 9's
  // pages (156+) would have needed 155 leading placeholder rows just to
  // make the arithmetic land correctly. Nullable: a family's own uploaded
  // photo (the original parent-facing flow) has no known page number.
  pageNumber       Int?
  examSubmissionId String?
  examSubmission   ExamSubmission? @relation(fields: [examSubmissionId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
}

// Admin-curated curriculum content (PLATFORM_PLAN.md §2.7): the canonical
// textbook/worksheet/classwork/homework set for a unit, shared across every
// student of that grade+curriculum once an admin approves it - not a
// per-family copy like UploadedPage. A family can still contribute one (goes
// in as "pending"), but once a type has an approved resource for a unit,
// further family uploads of that same type are frozen (see
// lib/unitResources.ts's FREEZABLE_TYPES) - one canonical copy is enough,
// and an admin can always add more. Exam question papers and answer sheets
// are also curatable here (as reference material for question-paper
// generation) but are deliberately never frozen for families - a student's
// own exam attempt is personal (Written Exam Capture & Coaching /
// ExamSubmission above), never a single shared copy.
model UnitResource {
  id               String    @id @default(cuid())
  unitId           String
  unit             Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  resourceType     String    // "textbook" | "worksheet" | "classwork" | "homework" | "exam_question_paper" | "answer_sheet"
  storageKey       String
  originalFilename String
  mimeType         String
  byteSize         Int
  status           String    @default("pending") // "pending" | "approved"
  uploadedByUserId String
  uploadedBy       User      @relation("ResourceUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  approvedByUserId String?
  approvedBy       User?     @relation("ResourceApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([unitId, resourceType, status])
}

// Written Exam Capture & Coaching (PLATFORM_PLAN.md §2.5): a kid photographs
// a real handwritten practice paper and gets feedback on exam technique
// (working shown, time use) before marks - marks are one data point among
// several, not the headline.
model ExamSubmission {
  id                String         @id @default(cuid())
  studentProfileId  String
  studentProfile    StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  unitId            String
  unit              Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  timeSpentMinutes  Int?
  status            String         @default("pending") // "pending" | "coached" | "failed"
  techniqueNotes     String[]
  overallNote        String?       @db.Text
  marksNote          String?       @db.Text
  pages             UploadedPage[]
  createdAt         DateTime       @default(now())
}

// --- progress / mastery ---

model TestAttempt {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  unitId           String
  unit             Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  attemptType      String         @default("progression_test") // "progression_test" | "diagnostic"
  difficulty       String         @default("moderate") // "easy" | "moderate" | "tough" - which QuestionPaper tier this attempt was against ("moderate" for diagnostics/pre-tiering history too)
  scorePct         Int
  band             String // MasteryBand
  perConcept       Json // Record<conceptId, {correct, total}>
  nextReviewDate   DateTime
  takenAt          DateTime       @default(now())

  @@index([studentProfileId, unitId, takenAt])
}

// Reasoning Interview (PLATFORM_PLAN.md §2.4): a short voice/text follow-up
// after a test asking the kid to explain their thinking, classified into why
// an answer was right/wrong - not just whether it was.
model ReasoningLog {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  conceptId        String
  concept          Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  question         String // the test question this follow-up relates to
  studentAnswer    String // what the kid originally answered
  explanation      String // how they explain their thinking, in their own words
  classification   String // "correct_reasoning" | "conceptual_gap" | "careless_slip" | "misread_question"
  note             String @db.Text // brief, kind, actionable feedback
  createdAt        DateTime @default(now())

  @@index([studentProfileId, createdAt])
}

model ConceptMastery {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  conceptId        String
  concept          Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  lastScorePct     Int
  band             String
  attempts         Int            @default(0)
  lastAttemptAt    DateTime
  nextReviewDue    DateTime

  @@unique([studentProfileId, conceptId])
}

// Admin-editable price list (PLATFORM_PLAN.md, 2026-08-20 pricing entry):
// one row per curriculum-board x grade-band cell, e.g. ("CBSE", "Grade 9-10",
// 9, 10, 289). Deliberately NOT foreign-keyed to Curriculum/Stage - only the
// Cambridge pathway has real seeded content today, but pricing needs to
// cover all 5 boards (Matric/CBSE/ICSE/IGCSE/IB) ahead of that content
// existing, since this is business planning, not a content gate. Grade-band
// lookup for an actual kid happens via a small label mapping in
// lib/pricing.ts, not a DB relation.
model PricingPlan {
  id                 String   @id @default(cuid())
  curriculumLabel    String   // "Matric / State Board" | "CBSE" | "ICSE" | "Cambridge IGCSE" | "IB"
  gradeBandLabel     String   // "Grade 3-5" | "Grade 6-8" | "Grade 9-10" | "Grade 11-12"
  minGrade           Int
  maxGrade           Int
  pricePerSubjectInr Int
  updatedAt          DateTime @updatedAt

  @@unique([curriculumLabel, gradeBandLabel])
}

// Caches AI-generated answers to student questions so a repeated or
// near-identical question - asked by a *different* kid, on the same
// concept - is served free instead of triggering a new Groq/Claude call
// (PLATFORM_PLAN.md, 2026-08-22 caching entry). Keyed by plain strings
// (unitKey/conceptKey), not a real foreign key to Unit/Concept -
// getUnit()'s returned shape doesn't expose the raw Prisma row id, and
// resolving it would cost an extra DB round-trip on the app's single
// hottest endpoint (/api/ask). Orphaned rows if a concept is ever deleted
// are harmless - they just never get hit again.
model AnswerCache {
  id                 String   @id @default(cuid())
  unitKey            String
  conceptKey         String
  language           String
  normalizedQuestion String // lowercased/trimmed/punctuation-stripped - the actual match key
  originalQuestion   String // first real question that produced this entry, for admin visibility
  answer             String   @db.Text
  hitCount           Int      @default(1)
  createdAt          DateTime @default(now())
  lastUsedAt         DateTime @default(now())

  @@unique([unitKey, conceptKey, language, normalizedQuestion])
  @@index([unitKey, conceptKey])
}

// Foundation for future adaptive personalization - logging only, no adaptive
// behavior-change logic built on top of this yet (deliberately deferred).
model InteractionEvent {
  id               String         @id @default(cuid())
  studentProfileId String
  studentProfile   StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  unitId           String?
  conceptId        String?
  concept          Concept?       @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  eventType        String // "voice_question" | "checkpoint_response" | "test_answer" | "diagnostic_answer"
  payload          Json
  createdAt        DateTime       @default(now())

  @@index([studentProfileId, createdAt])
}
